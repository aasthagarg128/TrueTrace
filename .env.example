# ---- Google Cloud ----
GOOGLE_CLOUD_PROJECT=truetrace-dev
GOOGLE_CLOUD_REGION=us-central1

# ---- Gemini ----
# Free tier from https://aistudio.google.com/apikey
# NOTE: free-tier prompts may be human-reviewed and used for training.
# TrueTrace therefore sends ONLY derived numeric signals to Gemini.
# Free key from https://aistudio.google.com/apikey - no billing account needed.
# Leave blank to use the built-in template explanations; nothing breaks.
# Only derived NUMBERS are ever sent. Never a frame, a URL, or an account id.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Accounts ----
# Signs session tokens. If unset, one is generated per process, which is
# secure but drops every session on restart.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_SECRET=
USER_STORE=data/users

# ---- Google Sign-In (optional) ----
# Leave blank to run with pseudonymous accounts only. When blank the API
# rejects /auth/google and the UI hides the button, so nothing half-works.
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:3000 to Authorised JavaScript origins.
GOOGLE_CLIENT_ID=

# ---- Case storage ----
# 'json' (default, local disk, no account) or 'firestore'.
# Firestore is free on Firebase's Spark plan. Authenticate with
# `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS.
# A misconfigured firestore backend logs an error and falls back to json.
CASE_BACKEND=json
FIRESTORE_COLLECTION=cases

# ---- Password reset email (optional) ----
# With no SMTP_HOST the reset link is LOGGED instead of sent, which is what
# you want locally - a reset that vanishes silently is far worse to debug.
# Any provider works, including Gmail with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Base URL used to build the reset link.
APP_BASE_URL=http://localhost:3000

# ---- Services ----
DETECTOR_URL=http://localhost:8081
AGENTS_PORT=8080

# ---- Storage ----
EVIDENCE_BUCKET=truetrace-evidence-dev
EVIDENCE_TTL_DAYS=7
EVIDENCE_DIR=data/evidence
# How often expired packages are swept. The sweep also runs once at startup.
RETENTION_INTERVAL_SECONDS=3600
# 32 bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
EVIDENCE_KEY=

# ---- Pub/Sub ----
TOPIC_ANALYSIS_REQUESTED=analysis-requested
TOPIC_ANALYSIS_COMPLETED=analysis-completed

# ---- Detection tuning ----
FRAME_SAMPLE_COUNT=16
MIN_SCORED_FRAMES=4
