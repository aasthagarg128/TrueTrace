# ---- Google Cloud ----
GOOGLE_CLOUD_PROJECT=truetrace-dev
GOOGLE_CLOUD_REGION=us-central1

# ---- Gemini ----
# Free tier from https://aistudio.google.com/apikey
# NOTE: free-tier prompts may be human-reviewed and used for training.
# TrueTrace therefore sends ONLY derived numeric signals to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Services ----
DETECTOR_URL=http://localhost:8081
AGENTS_PORT=8080

# ---- Storage ----
EVIDENCE_BUCKET=truetrace-evidence-dev
EVIDENCE_TTL_DAYS=7
# 32 bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
EVIDENCE_KEY=

# ---- Pub/Sub ----
TOPIC_ANALYSIS_REQUESTED=analysis-requested
TOPIC_ANALYSIS_COMPLETED=analysis-completed

# ---- Detection tuning ----
FRAME_SAMPLE_COUNT=16
MIN_SCORED_FRAMES=4
